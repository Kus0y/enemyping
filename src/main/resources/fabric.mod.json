{
        "schemaVersion": 1,
        "id": "enemyping",
        "version": "${version}",
        "name": "Enemy Ping",
        "description": "Shows other players' ping above their heads with configurable color ranges. Also adds the /enemyping command. Wyswietla ping innych graczy nad ich glowami.",
        "authors": [
                "Kus0y"
        ],
        "contact": {},
        "license": "MIT",
        "icon": "assets/enemyping/icon.png",
        "environment": "client",
        "entrypoints": {
                "client": [
                        "pl.enemyping.EnemyPing"
                ],
                "modmenu": [
                        "pl.enemyping.compat.ModMenuIntegration"
                ]
        },
        "mixins": [
                "enemyping.mixins.json"
        ],
        "depends": {
                "fabricloader": ">=0.19.0",
                "minecraft": "~1.21.11",
                "java": ">=21",
                "fabric-api": ">=0.141.0"
        },
        "suggests": {
                "modmenu": "*"
        }
}
